dnorm(x = 5, mean = 15, sd = 7, log = F)
dnorm(x = 5, mean = 15, sd = 7, log = 9)
rbinom(n = 10, prob = 0.75, size = 8)
dbinom(x = 10, prob = 0.75, size = 8)
dbinom(x = 5, prob = 0.75, size = 8)
pbinom(q = 55, prob = 0.75, size = 8)
pbinom(q = 55, prob = 0.75, size = 1)
pbinom(q = 5, prob = 0.75, size = 55)
pbinom(q = 5, prob = 0.75, size = 8)
qbinom(p = 5, prob = 0.75, size = 8)
qbinom(p = 5, prob = 0.75, size = 3)
qbinom(p = .75, prob = 0.75, size = 3)
rbinom(n = 5, prob = 0.75, size = 8)
# • What x means: The exact number of successes you want to evaluate.
# What it does: Calculates the Probability Mass Function (PMF). It gives you
# the exact probability of getting exactly 5 successes out of 8 trials.
dbinom(x = 5, prob = 0.75, size = 8)
# What n means: The number of independent simulations
# • Example Output: [6, 5, 7, 6, 4] (Each number represents how many Heads you
# got out of 8 flips in that specific experiment).
rbinom(n = 5, prob = 0.75, size = 8)
dbinom(x = 5, prob = 0.75, size = 8)
# • What q means: The maximum value cutoff on the x-axis.
# • What it does: Calculates the Cumulative Distribution Function (CDF).  (0 to 5)
pbinom(q = 5, prob = 0.75, size = 8)
# • What p means: A target cumulative probability (percentile) between 0 and 1.
# What it does: The Inverse CDF (Quantile function). It tells you the smallest
# integer number of successes required to reach or exceed that cumulative probability p.
qbinom(p = .75, prob = 0.75, size = 3)
# • What p means: A target cumulative probability (percentile) between 0 and 1.
# What it does: The Inverse CDF (Quantile function). It tells you the smallest
# integer number of successes required to reach or exceed that cumulative probability p.
qbinom(p = .75, prob = 0.75, size = 8)
# • What p means: A target cumulative probability (percentile) between 0 and 1.
# What it does: The Inverse CDF (Quantile function). It tells you the smallest
# integer number of successes required to reach or exceed that cumulative probability p.
qbinom(p = .75, prob = 0.75, size = 8)
