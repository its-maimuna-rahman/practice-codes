a <- 4; n <- 4; N <- a*n
CF <- sum(shr$gain)^2 / N
SST <- sum(shr$gain^2) - CF
SS_treat_sum <- tapply(shr$gain, shr$treat, sum)
SS_treat <- sum(SS_treat_sum^2) / n - CF
SSE <- SST - SS_treat
df_treat <- a-1
df_error <- N-a
MS_treat <- SS_treat / df_treat
MSE <- SSE / df_error
F_calc <- MS_treat / MSE
F_value <- qf(0.95, df_treat, df_error)
