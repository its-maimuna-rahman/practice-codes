r <- a
se <- sqrt(MSE / n)
t_critical_bonf <- qt(1-0.05 / (2*r), df_error)
means <- tapply(shr$gain, shr$treat, mean)
bonf_interval <- data.frame(
treat = names(treat),
mean = means,
min = means - t_critical_bonf * se,
max = means + t_critical_bonf * se
)
